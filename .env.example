# ==============================================================================
# LUXE ATELIER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Next.js Public Site URL
NEXT_PUBLIC_SITE_URL=https://online-store-gilt-gamma.vercel.app/

# Application URL (used for verification links, redirects, etc.)
# Must be set to the public-facing domain in production (e.g. https://yourstore.com)
APP_URL=https://online-store-gilt-gamma.vercel.app/

# Site / Brand Name (used in emails and UI)
SITE_NAME=Luxe Atelier

# Supabase Configuration (PostgreSQL, Auth & Realtime)
# Note: The platform runs completely zero-config standalone with automated in-memory/localStorage sync
# if these are not provided, or seamlessly connects to live Supabase when populated.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Upstash Redis Caching Layer (REST API)
# Automatically enables remote Redis caching with resilient in-memory LRU fallback.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# MongoDB Connection (Mongoose ODM)
# Used for database operations via the shared connection in src/lib/mongodb.js.
# For MongoDB Atlas, use: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/myWebsite
MONGODB_URI=mongodb://localhost:27017/myWebsite

# JWT Secret for Authentication
# Used to sign and verify session tokens. Change this to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret-string

# Reserved Admin Email
# The email that will be assigned the 'admin' role during registration.
# This is a server-side only configuration - do NOT expose via NEXT_PUBLIC_*.
ADMIN_EMAIL=gb8585438@gmail.com

# --- Email Verification (SMTP) ---
# SMTP configuration for sending verification emails.
# These values are server-side only and are NEVER exposed to the browser.
#
# For Gmail SMTP, use an App Password (not your regular Gmail password):
#   1. Enable 2-Factor Authentication on your Google account.
#   2. Go to Google Account > Security > 2-Step Verification > App passwords.
#   3. Generate a new app password for "Mail" and use it as SMTP_PASSWORD.
#   4. SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 (SSL) or 587 (TLS).
#
# For other providers (e.g. Outlook, Yahoo, custom SMTP):
#   SMTP_HOST=smtp.your-provider.com
#   SMTP_PORT=587 (TLS) or 465 (SSL)
#   SMTP_USER=your-email@your-domain.com
#   SMTP_PASSWORD=your-email-password-or-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# The "From" address shown in verification emails.
# If not set, the SMTP_USER will be used as the sender.
EMAIL_FROM=your-email@gmail.com

# Payment Provider (Stripe ready)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
